diff -ru tests/misc.sh tests/misc.sh
--- tests/misc.sh	2026-10-22 09:36:06.211143000 +0800
+++ tests/misc.sh	2026-10-22 09:36:06.238105000 +0800
@@ -180,6 +180,10 @@
 		if [ "${os}" != "FreeBSD" ]; then
 			return 1
 		fi
+		# VirtualBox shared folders have no file flags.
+		if [ "${fs}" = "VBOXVFS" ]; then
+			return 1
+		fi
 		# Only OSXFuse supports chflags
 		if [ "${fs%%.*}" = "FUSEFS" ]; then
 			return 1
@@ -194,8 +198,17 @@
 		if [ "${fs}" = "FUSE.GCSFUSE" -o "${fs}" = "FUSE.S3FS" ]; then
 			return 1
 		fi
+		# The VirtualBox shared folder protocol has no hard links.
+		if [ "${fs}" = "VBOXVFS" ]; then
+			return 1
+		fi
 		;;
-	mknod)
+	mknod|mkfifo)
+		# The VirtualBox shared folder protocol has no device nodes,
+		# fifos or sockets.
+		if [ "${fs}" = "VBOXVFS" ]; then
+			return 1
+		fi
 		;;
 	posix_fallocate)
 		if [ "${os}" != "FreeBSD" ]; then
@@ -211,6 +224,11 @@
 		# anyway.
 		# https://pubs.opengroup.org/onlinepubs/9699919799/functions/rename.html
 		case "${fs}" in
+		VBOXVFS)
+			# The host decides; FreeBSD and Linux hosts do not
+			# touch ctime on rename.
+			return 1
+			;;
 		EXT4)
 			return 0
 			;;
